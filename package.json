{
  "name": "clipboard",
  "version": "1.0.0",
  "private": true,
  "description": "CLIPBOARD - universal clipboard platform",
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=server\" \"npm run dev --workspace=frontend\"",
    "dev:server": "npm run dev --workspace=server",
    "dev:frontend": "npm run dev --workspace=frontend",
    "build": "npm run build --workspace=frontend",
    "test": "node --test tests/",
    "install:all": "npm install --workspace=server && npm install --workspace=frontend"
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.2",
    "@vercel/kv": "^3.0.0"
  }
}
